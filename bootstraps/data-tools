# Install jq, miller (mlr), make, unzip and curl: the data and build helpers
# the devtools bin/ scripts expect (csv2json needs mlr). apt or apk.
# Also runnable on an existing distro: sudo bash bootstraps/data-tools
if command -v apt-get >/dev/null 2>&1; then
    apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq miller make unzip curl ca-certificates
elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache jq miller make unzip curl ca-certificates
else
    echo "[ERROR] data-tools supports apt and apk only."
    exit 1
fi
jq --version
mlr --version
make --version | head -1
