# Enable systemd in /etc/wsl.conf.
# Requires WSL 0.67.6+ (Windows 11 or updated Windows 10).
# The distro must be restarted (wsl --terminate <name>) for this to take effect.
# Also keeps Windows interop working: every distro shares one WSLInterop binfmt entry, and a
# booting systemd (systemd-binfmt) clears it for ALL distros unless a binfmt.d file re-adds it
# (microsoft/WSL#8843). Without interop no distro can start powershell.exe, cmd.exe, code, ...
grep -qxF '[boot]' /etc/wsl.conf 2>/dev/null || printf '\n[boot]\nsystemd=true\n' >> /etc/wsl.conf
sed -i 's/^systemd=false/systemd=true/' /etc/wsl.conf
mkdir -p /etc/binfmt.d
[ -f /etc/binfmt.d/WSLInterop.conf ] || echo ':WSLInterop:M::MZ::/init:P' > /etc/binfmt.d/WSLInterop.conf
