# Install Claude Code with Anthropic's native installer (no npm) into ~/.local/bin/claude.
# Skipped if already installed; it keeps itself up to date. Pick a release channel or
# version with C2W_CLAUDE_VERSION=stable, latest or e.g. 2.1.300 (default: installer default).
# Needs curl (bootstraps devtools or data-tools). Sign in on first run: claude
# Also runnable on an existing distro: bash poststraps/claude
if ! command -v curl >/dev/null 2>&1; then echo "[ERROR] curl is not installed. Run bootstrap 'devtools' or 'data-tools' first."; exit 1; fi
CVER=%C2W_CLAUDE_VERSION%
case $CVER in *C2W_CLAUDE_VERSION*) CVER= ;; esac
if [ ! -x $HOME/.local/bin/claude ]; then curl -fsSL https://claude.ai/install.sh -o /tmp/claude-install.sh; bash /tmp/claude-install.sh $CVER; rm -f /tmp/claude-install.sh; fi
$HOME/.local/bin/claude --version
